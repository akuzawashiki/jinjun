body {
  margin: 0;
  font-family: sans-serif;
  background-color: #eaeaea;
  display: flex;
  justify-content: center;
  padding: 0px 0;
}

.phone-frame {
  width: 420px; /* スマホ幅 */
  max-width: 100%;
  background-color: #fff;
  border-radius: 0px;
  box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
  overflow-y: auto;
  padding: 5px;
  box-sizing: border-box;
  height: 100vh;
}

.spot {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 24px;
  gap: 12px;
  border: #000 solid 1px;
  padding: 3px;
}

.spot-description {
  flex: 1;
}

.spot-description h2 {
  margin: 0 0 6px;
  font-size: 16px;
}

.spot-description p {
  margin: 0;
  font-size: 14px;
}

.spot-image {
  width: 120px;
  height: 100%;
  object-fit: cover;
  border-radius: 0px;
  box-shadow: 0 1px 5px rgba(0, 0, 0, 0.1);
}

/* スクロールバー（任意） */
.phone-frame::-webkit-scrollbar {
  width: 6px;
}
.phone-frame::-webkit-scrollbar-thumb {
  background-color: #bbb;
  border-radius: 3px;
}
